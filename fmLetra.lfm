  object qrBUSCA: TZQuery
    Filtered = True
    Connection = DM.ADO
    SQL.Strings = (
      'SELECT MUSICAS.ID AS ID, MUSICAS.NOME AS NOME'
      'FROM MUSICAS'
      'ORDER BY MUSICAS.NOME')
    Left = 256
    Top = 196
  end
  object dsBUSCA: TDataSource
    DataSet = qrBUSCA
    Left = 324
    Top = 196
  end
  object qrLETRA: TZQuery
    Filtered = True
    Connection = DM.ADO
    SQL.Strings = (
      'SELECT ID,MUSICA,LETRA,LETRA_AUX FROM MUSICAS_LETRA'
      'WHERE MUSICA = :MUSICA'
      'ORDER BY ORDEM')
    Left = 256
    Top = 244
    ParamData = <
      item
        Name = 'MUSICA'
        ParamType = ptInput
      end>
  end
  object qrALBUNS: TZQuery
    Filtered = True
    Connection = DM.ADO
    SQL.Strings = (
      'SELECT A.ID,A.NOME FROM ALBUM_MUSICAS AM'
      'LEFT JOIN ALBUM A ON (A.ID = AM.ID_ALBUM)'
      'WHERE AM.ID_MUSICA = :MUSICA'
      'ORDER BY A.NOME')
    Left = 256
    Top = 292
    ParamData = <
      item
        Name = 'MUSICA'
        ParamType = ptInput
      end>
  end
  object dsALBUNS: TDataSource
    DataSet = qrALBUNS
    Left = 316
    Top = 292
  end
end
