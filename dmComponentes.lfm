  object qrSLIDE_MUSICA_ALBUM: TZQuery
    Connection = ADO
    SQL.Strings = (
      'SELECT'
      '  A.ID_ALBUM,'
      '  A.FAIXA,'
      '  A.FAIXA||" - "||M.NOME AS NOME_FAIXA,'
      '  M.*'
      'FROM'
      '  MUSICAS M'
      'LEFT JOIN'
      '  ALBUM_MUSICAS A ON A.ID_MUSICA = M.ID'
      'WHERE'
      '  ID_ALBUM = :ID_ALBUM'
      'ORDER BY A.FAIXA,M.NOME')
    Left = 232
    Top = 328
  end
