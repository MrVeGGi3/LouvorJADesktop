  object qrSEL_MUSICAS_IDMUS: TZQuery
    Connection = ADO
    SQL.Strings = (
      
        'SELECT ALBUM.URL AS URL_ALBUM,ALBUM.IMAGEM,MUSICA.* FROM MUSICA,' +
        'ALBUM'
      'WHERE MUSICA.ID = :ID    '
      '      AND MUSICA.ALBUM = ALBUM.ID'
      'ORDER BY MUSICA.FAIXA,MUSICA.NOME')
    Left = 40
    Top = 280
  end
