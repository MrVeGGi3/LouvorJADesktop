  object qrBUSCA_VERSAO_1: TZQuery
    Filtered = True
    Connection = ADO
    SQL.Strings = (
      
        'SELECT VERSAO_BIBLICA.SIGLA VERSAO,LIVRO.LIVRO LIVRO,LIVRO.SIGLA' +
        ' SIGLA FROM VERSAO_BIBLICA,'
      'LIVRO'
      'WHERE LIVRO.ID=1'
      'LIMIT 1')
