  object qrHINOS: TZQuery
    Filtered = True
    Connection = ADO
    SQL.Strings = (
      'SELECT * FROM HINARIO_ADVENTISTA'
      'WHERE '
      '    (CAST(:VALOR AS INTEGER) > 0 AND FAIXA = :VALOR) '
      '    OR '
      
        '    (CAST(:VALOR AS INTEGER) <= 0 AND NOME_SEMAC LIKE '#39'%'#39' || :VA' +
        'LOR || '#39'%'#39')')
    Left = 472
    Top = 280
  end
  object qrBIBLIA_VERSAO: TZQuery
    Connection = ADO
    SQL.Strings = (
      'SELECT '
      '    SIGLA,'
      '    VERSAO,'
      '    VERSAO || '#39' ('#39' || SIGLA || '#39')'#39' AS VERSAO_DESC'
      'FROM VERSAO_BIBLICA'
      'ORDER BY VERSAO;')
    Left = 520
    Top = 280
  end
