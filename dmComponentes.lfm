  object qrHINOSN: TZQuery
    Filtered = True
    Connection = ADO
    SQL.Strings = (
      'SELECT * FROM HINARIO_ADVENTISTA_1996'
      'WHERE '
      '    (CAST(:VALOR AS INTEGER) > 0 AND FAIXA = :VALOR) '
      '    OR '
      
