  object qrHINOSN: TZQuery
    Filtered = True
    Connection = ADO
    SQL.Strings = (
      'SELECT * FROM HINARIO_ADVENTISTA_1996'
      'WHERE '
      '    (CAST(:VALOR AS INTEGER) > 0 AND FAIXA = :VALOR) '
      '    OR '
      
        '    (CAST(:VALOR AS INTEGER) <= 0 AND NOME_SEMAC LIKE '#39'%'#39' || :VA' +
        'LOR || '#39'%'#39')')
    Left = 328
    Top = 280
  end
  object dsHINOSN: TDataSource
    DataSet = qrHINOSN
    Left = 232
    Top = 136
  end
