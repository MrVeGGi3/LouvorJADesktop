  object qrBUSCA_MAX_VERSOS: TZQuery
    Connection = ADO
    SQL.Strings = (
      'SELECT MAX(VERSICULO) AS MAX_VERSICULO'
      'FROM BIBLIA'
      'WHERE BIBLIA.LIVRO=:LIVRO AND BIBLIA.CAPITULO=:CAPITULO')
    Left = 136
    Top = 328
  end
  object qrBUSCA: TZQuery
    Filtered = True
    Connection = ADO
    SQL.Strings = (
      
        'SELECT '#39#39' AS ICONE1,'#39#39' AS ICONE2,'#39#39' AS ICONE3, LISTA_MUSICAS_TOD' +
        'AS.*'
      'FROM LISTA_MUSICAS_TODAS'
      'WHERE  1=1'
      '    AND '#39','#39' || :TIPO || '#39','#39' LIKE '#39'%,'#39' || TIPO || '#39',%'#39
      ''
      '    AND ('
      
        '        (:OPC_NOME = '#39'S'#39' AND NOME_SEMAC LIKE '#39'%'#39' || :VALOR || '#39'%' +
        #39' )'
      '        OR'
      
        '        (:OPC_LETRA = '#39'S'#39' AND LETRA_SEMAC LIKE '#39'%'#39' || :VALOR || ' +
        #39'%'#39' )'
      '        OR'
      
        '        (:OPC_ALBUM = '#39'S'#39' AND NOME_ALBUM_COM_SEMAC LIKE '#39'%'#39' || :' +
        'VALOR || '#39'%'#39' )'
      '    )'
      ''
      '    AND NOME LIKE :INICIAL || '#39'%'#39
      ''
      'ORDER BY NOME')
    Left = 184
    Top = 328
  end
  object qrMUSICAS: TZQuery
    Connection = ADO
    SQL.Strings = (
      'SELECT DISTINCT'
      '  A.ID_ALBUM AS ID_ALBUM,'
      '  A.FAIXA AS FAIXA,'
      '  A.FAIXA || '#39' - '#39' || M.NOME AS NOME_FAIXA,'
      '  M.ID AS ID,'
      '  M.ALBUM AS ALBUM,'
      '  M.NOME AS NOME,'
      '  M.IMAGEM AS IMAGEM,'
      '  M.URL AS URL,'
      '  M.URL_INSTRUMENTAL AS URL_INSTRUMENTAL,'
      '  M.IDIOMA AS IDIOMA,'
      '  M.TAMANHO_LETRA AS TAMANHO_LETRA,'
      '  M.COR_LETRA AS COR_LETRA,'
      '  M.FUNDO_LETRA AS FUNDO_LETRA,'
      '  M.TAMANHO_IMAGEM AS TAMANHO_IMAGEM,'
      '  M.TAMANHO_ARQUIVO AS TAMANHO_ARQUIVO,'
      '  M.TAMANHO_ARQUIVO_PB AS TAMANHO_ARQUIVO_PB,'
      '  M.LETRA AS LETRA'
      'FROM'
      '  MUSICAS M'
      'LEFT JOIN'
      '  ALBUM_MUSICAS A ON A.ID_MUSICA = M.ID'
      'WHERE'
      '  ID_ALBUM = :ID_ALBUM'
      'ORDER BY A.FAIXA, M.NOME;')
    Left = 664
    Top = 280
  end
